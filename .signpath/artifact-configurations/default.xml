<?xml version="1.0" encoding="utf-8"?>
<!--
  Tells SignPath what to sign. GitHub's upload-artifact wraps the exe in a zip, so the root is a zip-file
  containing the exe, which gets an Authenticode signature.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="NSSMServicesManager-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
