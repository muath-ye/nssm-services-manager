{
  "name": "nssm-services-manager",
  "version": "1.0.0",
  "description": "Start, stop and manage Windows services powered by NSSM",
  "main": "main.js",
  "scripts": {
    "css": "tailwindcss -i ./src/input.css -o ./renderer/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./renderer/styles.css --watch",
    "start": "npm run css && electron .",
    "dist": "npm run css && electron-builder --win --publish never"
  },
  "build": {
    "appId": "sa.cartrust.nssmservicesmanager",
    "productName": "NSSM Services Manager",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NSSMServicesManager-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "NSSMServicesManager-Portable-${version}.exe"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^3.4.14"
  }
}
