{
  "name": "nssm-services-manager",
  "version": "1.0.0",
  "description": "Start, stop and manage Windows services powered by NSSM",
  "private": true,
  "scripts": {
    "setup": "neu update",
    "css": "tailwindcss -i ./src/input.css -o ./resources/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./resources/styles.css --watch",
    "dev": "npm run css && neu run",
    "build": "npm run css && node scripts/build.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@neutralinojs/neu": "^11.8.0",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.14"
  }
}
